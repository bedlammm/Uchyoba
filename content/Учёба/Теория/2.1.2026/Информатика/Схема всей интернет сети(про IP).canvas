{
	"nodes":[
		{"id":"5bd02a3d0e55b73e","type":"group","x":-460,"y":1580,"width":1060,"height":1300,"label":"Серые IP локальной сети"},
		{"id":"6c5e146109738eec","type":"group","x":-460,"y":760,"width":1060,"height":700,"color":"#ffffff","label":"Любые белые ip В сети интернет - видят друг друга напрямую"},
		{"id":"8defe23eb6b767ec","type":"group","x":-446,"y":2280,"width":1032,"height":600,"color":"6","label":"NAT"},
		{"id":"3e5aa1ac67818f38","type":"group","x":-600,"y":-40,"width":1250,"height":480,"label":"5 больших регионов, которым IANA раздала огромные блоки IPv4"},
		{"id":"01d5282f11138771","type":"group","x":-446,"y":900,"width":1033,"height":272,"color":"4","label":"Конкретно эти условно в дата центрах стоят"},
		{"id":"d4a3f60a32cf4e45","type":"group","x":-446,"y":2400,"width":1032,"height":180,"color":"2","label":"Для домашнего WIFI роутера"},
		{"id":"d9c529e5e699d13d","type":"group","x":-446,"y":1250,"width":1032,"height":170,"color":"5","label":"А вот эти идут для мобильной связи и на домашние WIFI роутеры"},
		{"id":"e1abc667dec2c5ec","type":"text","text":"# Крупные ==**локальные для каждого региона**== телеком-компании (В России - Ростелеком, Мегафон, дата-центры) покупают статус локального регистратора и получают от RIPE пулы адресов поменьше.","x":-200,"y":480,"width":537,"height":220},
		{"id":"2d1b8b4d034e7273","type":"text","text":"# *Все IP примерные и условные*","x":-150,"y":780,"width":430,"height":50},
		{"id":"c7285c6dfc5ef49e","type":"text","text":"# 8.8.8.8","x":-426,"y":920,"width":319,"height":100},
		{"id":"443e2c375deceb93","type":"text","text":"# 178.154.217.93","x":38,"y":920,"width":328,"height":100},
		{"id":"f30d1f2b6bc5e3d4","type":"text","text":"# 89.125.131.203","x":-210,"y":1052,"width":328,"height":100},
		{"id":"d8fa184068017287","type":"text","text":"# 1.1.1.1","x":238,"y":1052,"width":328,"height":100},
		{"id":"9e446f17d275b855","type":"text","text":"# IP, который присваивается роутеру","x":315,"y":1270,"width":251,"height":130},
		{"id":"9150f886b55f7335","type":"text","text":"# 46.138.35.155","x":-426,"y":1305,"width":250,"height":60},
		{"id":"10815c20bbbcf73d","type":"text","text":"### **APNIC** (Asia Pacific Network Information Centre) — Азиатско-Тихоокеанский регион.","x":320,"y":-20,"width":310,"height":160},
		{"id":"6b5b613e6380ed87","type":"text","text":"#### **AFRINIC** (African Network Information Centre) — Африка.","x":100,"y":260,"width":340,"height":160},
		{"id":"876dec26c8e45c6e","type":"text","text":"#### **LACNIC** (Latin America and Caribbean Network Information Centre) — Латинская Америка и части Карибского бассейна.","x":-360,"y":260,"width":340,"height":160},
		{"id":"97e38dc6bc84faa9","type":"text","text":"# IP, который идёт на вышку сотовой связи","x":-102,"y":1305,"width":340,"height":60},
		{"id":"99760029f2f7fcff","type":"text","text":"# DHCP сервер, будь то домашний WIFI роутер, сервер на компьютере или просто инструмент в виртуальной машине, раздаёт IP с доступом в интернет(необязательно, чтобы изначальный IP был белым, то есть кластеризировать так локальные IP можно бесконечно) таким образом, что все устройства в локальной сети получают какой-то из локальных IP:","x":-426,"y":1620,"width":992,"height":220},
		{"id":"f7c102cdf5c6320f","type":"text","text":"### **ARIN** (American Registry for Internet Numbers) — США, Канада, многие острова Карибского моря.","x":-117,"y":60,"width":310,"height":160},
		{"id":"dcccc5ac9c77a650","type":"text","text":"##### **RIPE NCC** (Réseaux IP Européens Network Coordination Centre) — Европа, Ближний Восток и Центральная Азия.","x":-576,"y":60,"width":310,"height":160},
		{"id":"067797dd0d68021f","type":"text","text":"### 10.0.0.0 — 10.255.255.255","x":-445,"y":1980,"width":321,"height":50},
		{"id":"49d263e3a4b07f3d","type":"text","text":"### 172.16.0.0 — 172.31.255.255 ","x":-107,"y":1980,"width":327,"height":50},
		{"id":"7324abcdf22e66ea","type":"text","text":"### 192.168.0.0 — 192.168.255.255","x":240,"y":1980,"width":360,"height":50},
		{"id":"ac4bda44376b5f41","type":"text","text":"# Локальный серый IP не имеет прямого доступа ни к какому из существующих белых IP, так что выход в интернет с любого серого IP выглядит так:","x":-433,"y":2080,"width":992,"height":140},
		{"id":"c71a5e7877a7b8af","type":"text","text":"# Серый IP компьютера","x":-425,"y":2467,"width":250,"height":65},
		{"id":"60bc689f967648b4","type":"text","text":"# Любой другой белый IP","x":191,"y":2469,"width":376,"height":60},
		{"id":"ffe2457ba55d9655","type":"text","text":"# Роутер с белым IP(имеет доступ к другим белым IP)","x":-123,"y":2440,"width":294,"height":104},
		{"id":"05fe08d6fb277870","type":"text","text":"# Ещё один серый Ip Виртуальной машины на компьютере, который она получает через встроенную DHCP виртуалки ","x":-425,"y":2580,"width":318,"height":288,"color":"3"},
		{"id":"6349d0568e0ff0f4","type":"text","text":"# Организация **IANA** ","x":-90,"y":-220,"width":310,"height":60},
		{"id":"5ce306741df53ff7","type":"text","text":"# NAT - технология, отвечающая за то, что устройство, получившее IP с какого-то DHCP сервера в итоге выйдет в интернет под белым IP","x":24,"y":2624,"width":457,"height":200}
	],
