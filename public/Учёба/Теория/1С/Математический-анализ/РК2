  /* --- ПРИНУДИТЕЛЬНЫЙ РЕЖИМ ПЕЧАТИ --- */
@media print {
    
    /* 1. Глобальные переменные (Catppuccin Mocha) */
    :root {
        --pdf-bg: #1e1e2e !important;       /* Основной фон */
        --pdf-text: #cdd6f4 !important;     /* Основной текст */
        --pdf-accent: #89b4fa !important;   /* Ссылки и заголовки */
        --pdf-bold: #fab387 !important;     /* Жирный текст */
        --pdf-code-bg: #313244 !important;  /* Фон кода и блоков */
        --pdf-border: #45475a !important;   /* Рамки */
    }

    /* 2. Сброс настроек экономии чернил браузера */
    * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        text-shadow: none !important; /* Убираем тени, они мылят текст */
        box-shadow: none !important;  /* Убираем лишние тени блоков */
    }

    /* 3. "Ядерный" сброс цвета текста */
    /* Селектор * перекрашивает вообще всё, если не указано иное */
    *, *:before, *:after, 
    div, p, span, li, td, th {
        color: var(--pdf-text) !important;
        -webkit-text-fill-color: var(--pdf-text) !important; /* Критично для Chrome! */
        background-color: transparent !important; /* Сбрасываем белые фоны */
        border-color: var(--pdf-border) !important;
    }

    /* 4. Настройка Фона Страницы */
    body, .print, .pdf-output, .markdown-preview-view, .markdown-rendered {
        background-color: var(--pdf-bg) !important;
        /* Убеждаемся, что фон действительно залит */
        background-image: none !important; 
    }

    /* 5. Убираем поля страницы */
    @page {
        margin: 0 !important;
        background-color: var(--pdf-bg) !important;
    }

    /* 6. ИСПРАВЛЕНИЕ НЕВИДИМЫХ ФОРМУЛ (MathJax/LaTeX) */
    /* Красим SVG-векторы и контейнеры */
    .MathJax, .mjx-chtml, .mjx-container, .MathJax_SVG,
    svg, path, rect, polygon, circle {
        color: var(--pdf-text) !important;
        fill: var(--pdf-text) !important;   /* Заливка вектора */
        stroke: var(--pdf-text) !important; /* Обводка вектора */
        -webkit-text-fill-color: var(--pdf-text) !important;
    }
    /* Убираем возможную нулевую прозрачность */
    .MathJax g, .MathJax svg {
        opacity: 1 !important;
    }

    /* 7. Callouts (Блоки) */
    .callout {
        background-color: var(--pdf-code-bg) !important;
        border: 1px solid var(--pdf-border) !important;
        border-left-width: 5px !important;
        border-radius: 5px !important;
        opacity: 1 !important;
    }
    
    /* Текст внутри коллаутов должен быть видимым */
    .callout-content, .callout-title {
        color: var(--pdf-text) !important;
    }

    /* 8. Код и преформатированный текст */
    code, pre {
        background-color: var(--pdf-code-bg) !important;
        color: var(--pdf-text) !important;
        border: 1px solid var(--pdf-border) !important;
        border-radius: 4px !important;
    }
    
    /* Сброс подсветки синтаксиса в белый, чтобы было видно */
    .token, span[class*="token"] {
        color: var(--pdf-text) !important;
    }

    /* 9. Акценты (Заголовки, Ссылки, Жирный) */
    h1, h2, h3, h4, h5, h6 {
        color: var(--pdf-accent) !important;
        -webkit-text-fill-color: var(--pdf-accent) !important;
        border-bottom: 1px solid var(--pdf-border) !important;
    }

    a, .cm-link, a:visited {
        color: var(--pdf-accent) !important;
        -webkit-text-fill-color: var(--pdf-accent) !important;
        text-decoration: underline !important;
    }

    b, strong {
        color: var(--pdf-bold) !important;
        -webkit-text-fill-color: var(--pdf-bold) !important;
    }

    /* 10. Таблицы */
    table {
        border-collapse: collapse !important;
    }
    td, th {
        border: 1px solid var(--pdf-border) !important;
        padding: 5px !important;
    }
